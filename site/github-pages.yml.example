# Inactive example. Move to .github/workflows/ only after review.
# Manual deployment only; no push or pull_request trigger.
name: Publish MDAS documentation

on:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: mdas-pages
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - uses: astral-sh/setup-uv@v6
        with:
          version: '0.13.5'
      - name: Configure Pages
        uses: actions/configure-pages@v5
      - name: Build and check documentation
        run: python site/build.py
      - name: Upload website only
        uses: actions/upload-pages-artifact@v4
        with:
          path: site/_build/html

  deploy:
    needs: build
    runs-on: ubuntu-latest
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
